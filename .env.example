# Website origin; exact callbacks and MCP audience must match the deployment.
APP_BASE_URL=http://localhost:3000
MCP_AUDIENCE=http://localhost:3000/mcp

# First-party email/password session signing secret (32+ random bytes in production).
AUTH_SECRET=

# Optional Auth0 OIDC login in addition to first-party accounts.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# PostgreSQL connection string: use pglite://.data/pgdata for embedded local persistence or postgresql://... for hosted PostgreSQL (restricted application role).
DATABASE_URL=pglite://.data/pgdata
TRACKER_DB_POOL_MAX=3
# Local migration command / runtime role setup when using hosted PostgreSQL.
MIGRATION_DATABASE_URL=
APP_DB_PASSWORD=

# Optional Supabase binary storage (when unset, uploaded resumes are stored in PostgreSQL).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes

# DeepSeek powers Resume Fit Analysis and Tailored LaTeX Resume Generation.
DEEPSEEK_API_KEY=
RESUME_AI_DAILY_LIMIT=20

# Optional website assistant / discovery billing.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.6-terra
OPENAI_DISCOVERY_MODEL=gpt-5.5
ASSISTANT_DAILY_LIMIT=40
DISCOVERY_DAILY_LIMIT=5
