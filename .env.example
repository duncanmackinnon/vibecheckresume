# Website origin; exact callbacks and MCP audience must match the deployment.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
MCP_AUDIENCE=http://localhost:3000/mcp

# Restricted application login (never the Supabase administrative database user).
DATABASE_URL=
TRACKER_DB_POOL_MAX=3
# Local migration command only. Do not add the administrative URL to Vercel runtime.
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes

DEEPSEEK_API_KEY=
# Optional, separately billed website assistant and server discovery. Billed to the deployment; users do not link ChatGPT subscriptions.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.6-terra
OPENAI_DISCOVERY_MODEL=gpt-5.5
RESUME_AI_DAILY_LIMIT=20
ASSISTANT_DAILY_LIMIT=40
DISCOVERY_DAILY_LIMIT=5
